APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Template ini dipakai juga sebagai sumber env saat deploy. Debug sengaja
# mati supaya deploy yang lupa menimpa nilai ini tidak menampilkan stack
# trace ke publik. Untuk pengembangan lokal, ubah menjadi true di .env.
APP_DEBUG=false
APP_URL=http://localhost:8000

# Alamat halaman masuk petugas. Halaman ini sengaja tidak ditautkan di situs
# pelapor, jadi alamatnya boleh diganti kapan saja kalau dianggap bocor —
# setelah diganti, jalankan config:clear dan route:clear.
RUTE_MASUK=petugas/masuk

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Rentang IP proxy yang boleh memasok X-Forwarded-*. Kosong berarti memakai
# daftar bawaan di config/proxy.php (jaringan privat + loopback). Isi hanya
# kalau edge platform berada di rentang lain, misalnya Render:
# TRUSTED_PROXIES=74.220.48.0/24,74.220.56.0/24
TRUSTED_PROXIES=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Nilai aman untuk server: riwayat debug penuh tidak ikut tertulis ke log
# produksi. Set debug hanya di .env mesin pengembang.
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# smtp, bukan log: kalau kredensial belum diisi, pengiriman gagal dengan
# pesan yang terlihat di queue alih-alih email verifikasi hilang diam-diam
# ke berkas log. Untuk lokal tanpa SMTP, ganti menjadi log di .env.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
